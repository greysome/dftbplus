From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 24 Feb 2026 14:54:55 +0000
Subject: [PATCH] Add GroupsPostScc: separate MPI group count for post-SCC phase

Introduces one new key under the Parallel {} HSD block:

  GroupsPostScc = N  ! MPI groups for post-SCC phase (default: same as Groups)

TParallelOpts gains nGroupPostScc.  TEnvironment gains a second TMpiEnv
(mpiPostScc) and TBlacsEnv (blacsPostScc), each initialised from the same
globalComm but with the post-SCC nGroup value.

At the start of post-SCC processing inside processGeometry, the live
env%mpi / env%blacs are saved to local variables and replaced with their
post-SCC counterparts so all downstream routines automatically pick up the
new layout.  At the end of processGeometry the originals are restored, so
that the next geometry step's SCC loop starts with the correct diag layout.
This makes the swap safe for geometry optimisations and MD runs.

Patch applies against 8f95b9b3 (release-24.1).  Apply with:

  git am 0001-mpi-config-diagonalization-postscc.patch

https://claude.ai/code/session_01EpL8g7FBYmjnGa8AEY96WJ
---
diff --git a/src/dftbp/common/environment.F90 b/src/dftbp/common/environment.F90
index 028baa2a..470058d8 100644
--- a/src/dftbp/common/environment.F90
+++ b/src/dftbp/common/environment.F90
@@ -51,9 +51,15 @@ module dftbp_common_environment
     !> Global mpi settings
     type(TMpiEnv), public :: mpi
 
+    !> MPI settings for post-SCC phase (different nGroup, same globalComm)
+    type(TMpiEnv), public :: mpiPostScc
+
     !> Whether MPI environment had been initialised
     logical :: mpiInitialised = .false.
 
+    !> Whether post-SCC MPI environment had been initialised
+    logical, public :: mpiPostSccInitialised = .false.
+
   #:endif
 
   #:if WITH_SCALAPACK
@@ -61,8 +67,14 @@ module dftbp_common_environment
     !> Global scalapack settings
     type(TBlacsEnv), public :: blacs
 
+    !> BLACS grid for post-SCC phase
+    type(TBlacsEnv), public :: blacsPostScc
+
     !> Whether BLACS environment had been initialised
     logical :: blacsInitialised = .false.
+
+    !> Whether post-SCC BLACS environment had been initialised
+    logical, public :: blacsPostSccInitialised = .false.
   #:endif
 
   #:if WITH_MAGMA
@@ -80,10 +92,12 @@ module dftbp_common_environment
 
   #:if WITH_MPI
     procedure :: initMpi => TEnvironment_initMpi
+    procedure :: initMpiPostScc => TEnvironment_initMpiPostScc
   #:endif
 
   #:if WITH_SCALAPACK
     procedure :: initBlacs => TEnvironment_initBlacs
+    procedure :: initBlacsPostScc => TEnvironment_initBlacsPostScc
   #:endif
 
   #:if WITH_MAGMA
@@ -196,6 +210,10 @@ contains
     end if
 
     #:if WITH_SCALAPACK
+      if (this%blacsPostSccInitialised) then
+        call TBlacsEnv_final(this%blacsPostScc)
+        this%blacsPostSccInitialised = .false.
+      end if
       if (this%blacsInitialised) then
         call TBlacsEnv_final(this%blacs)
         this%blacsInitialised = .false.
@@ -203,6 +221,10 @@ contains
     #:endif
 
     #:if WITH_MPI
+      if (this%mpiPostSccInitialised) then
+        call TMpiEnv_final(this%mpiPostScc)
+        this%mpiPostSccInitialised = .false.
+      end if
       if (this%mpiInitialised) then
         call TMpiEnv_final(this%mpi)
         this%mpiInitialised = .false.
@@ -272,6 +294,21 @@ contains
 
   end subroutine TEnvironment_initMpi
 
+
+  !> Initializes the post-SCC MPI environment with a (potentially different) group count.
+  subroutine TEnvironment_initMpiPostScc(this, nGroup)
+
+    !> Instance
+    class(TEnvironment), intent(inout) :: this
+
+    !> Number of process groups for post-SCC phase
+    integer, intent(in) :: nGroup
+
+    call TMpiEnv_init(this%mpiPostScc, globalMpiComm=this%mpi%globalComm, nGroup=nGroup)
+    this%mpiPostSccInitialised = .true.
+
+  end subroutine TEnvironment_initMpiPostScc
+
 #:endif
 
 
@@ -304,6 +341,35 @@ contains
 
   end subroutine TEnvironment_initBlacs
 
+
+  !> Initializes the post-SCC BLACS environment using the post-SCC MPI communicators.
+  subroutine TEnvironment_initBlacsPostScc(this, rowBlock, colBlock, nOrb, nAtom, errStatus)
+
+    !> Instance
+    class(TEnvironment), intent(inout) :: this
+
+    !> Row block size
+    integer, intent(in) :: rowBlock
+
+    !> Column block size
+    integer, intent(in) :: colBlock
+
+    !> Nr. of orbitals
+    integer, intent(in) :: nOrb
+
+    !> Nr. of atoms
+    integer, intent(in) :: nAtom
+
+    !> Operation status, if an error needs to be returned
+    type(TStatus), intent(inout) :: errStatus
+
+    call TBlacsEnv_init(this%blacsPostScc, this%mpiPostScc, rowBlock, colBlock, nOrb, nAtom,&
+        & errStatus)
+    @:PROPAGATE_ERROR(errStatus)
+    this%blacsPostSccInitialised = .true.
+
+  end subroutine TEnvironment_initBlacsPostScc
+
 #:endif
 
 
diff --git a/src/dftbp/dftbplus/initprogram.F90 b/src/dftbp/dftbplus/initprogram.F90
index a18f55fe..db103fcb 100644
--- a/src/dftbp/dftbplus/initprogram.F90
+++ b/src/dftbp/dftbplus/initprogram.F90
@@ -1409,6 +1409,12 @@ contains
 
   #:if WITH_MPI
     call env%initMpi(input%ctrl%parallelOpts%nGroup)
+    block
+      integer :: nGroupPostScc
+      nGroupPostScc = input%ctrl%parallelOpts%nGroupPostScc
+      if (nGroupPostScc == 0) nGroupPostScc = input%ctrl%parallelOpts%nGroup
+      call env%initMpiPostScc(nGroupPostScc)
+    end block
   #:endif
 
     call initGeometry_(env, input, this%nAtom, this%nType, this%tPeriodic, this%tHelical,&
@@ -1561,6 +1567,14 @@ contains
       end if
       call error(errStatus%message)
     end if
+    call initBlacsPostScc(input%ctrl%parallelOpts%blacsOpts, this%nAtom, this%nOrb,&
+        & this%t2Component, env, errStatus)
+    if (errStatus%hasError()) then
+      if (errStatus%code == -1) then
+        call warning("Insufficient atoms for this number of MPI processors (post-SCC grid)")
+      end if
+      call error(errStatus%message)
+    end if
   #:endif
     call TParallelKS_init(this%parallelKS, env, this%nKPoint, this%nIndepSpin)
 
@@ -5638,6 +5652,40 @@ contains
   end subroutine initBlacs
 
 
+  !> Initialises the post-SCC BLACS grid (same block sizes, post-SCC MPI layout).
+  subroutine initBlacsPostScc(blacsOpts, nAtom, nOrb, t2Component, env, errStatus)
+
+    !> BLACS settings
+    type(TBlacsOpts), intent(in) :: blacsOpts
+
+    !> Number of atoms
+    integer, intent(in) :: nAtom
+
+    !> Number of orbitals
+    integer, intent(in) :: nOrb
+
+    !> Is this a two component calculation
+    logical, intent(in) :: t2Component
+
+    !> Computing environment data
+    type(TEnvironment), intent(inout) :: env
+
+    !> Operation status, if an error needs to be returned
+    type(TStatus), intent(inout) :: errStatus
+
+    integer :: sizeHS
+
+    if (t2Component) then
+      sizeHS = 2 * nOrb
+    else
+      sizeHS = nOrb
+    end if
+    call env%initBlacsPostScc(blacsOpts%blockSize, blacsOpts%blockSize, sizeHS, nAtom, errStatus)
+    @:PROPAGATE_ERROR(errStatus)
+
+  end subroutine initBlacsPostScc
+
+
   !> Generate descriptions of large dense matrices in BLACS decomposition
   !! Note: It must be called after getDenseDescCommon() has been called.
   subroutine getDenseDescBlacs(env, rowBlock, colBlock, denseDesc, isSparseReorderRequired)
diff --git a/src/dftbp/dftbplus/inputdata.F90 b/src/dftbp/dftbplus/inputdata.F90
index 62f0a63b..deb4186c 100644
--- a/src/dftbp/dftbplus/inputdata.F90
+++ b/src/dftbp/dftbplus/inputdata.F90
@@ -76,6 +76,9 @@ module dftbp_dftbplus_inputdata
     !> Number of processor groups
     integer :: nGroup
 
+    !> Number of processor groups for post-SCC processing (0 = same as nGroup)
+    integer :: nGroupPostScc = 0
+
     !> Blacs options
     type(TBlacsOpts) :: blacsOpts
 
diff --git a/src/dftbp/dftbplus/main.F90 b/src/dftbp/dftbplus/main.F90
index ef75bd7f..e4ecd37a 100644
--- a/src/dftbp/dftbplus/main.F90
+++ b/src/dftbp/dftbplus/main.F90
@@ -15,6 +15,12 @@ module dftbp_dftbplus_main
   use dftbp_common_environment, only : globalTimers, TEnvironment
   use dftbp_common_file, only : closeFile, openFile, TFileDescr
   use dftbp_common_globalenv, only : stdOut, withMpi
+#:if WITH_MPI
+  use dftbp_common_mpienv, only : TMpiEnv
+#:endif
+#:if WITH_SCALAPACK
+  use dftbp_common_blacsenv, only : TBlacsEnv
+#:endif
   use dftbp_common_hamiltoniantypes, only : hamiltonianTypes
   use dftbp_common_status, only : TStatus
   use dftbp_derivs_numderivs2, only : dipoleAdd, getHessianMatrix, next, polAdd, TNumderivs
@@ -1156,6 +1162,12 @@ contains
 
     integer :: iKS, iConstrIter, nConstrIter
     logical :: isFirstDet
+#:if WITH_MPI
+    type(TMpiEnv) :: savedMpi
+#:endif
+#:if WITH_SCALAPACK
+    type(TBlacsEnv) :: savedBlacs
+#:endif
 
     if (this%tDipole) allocate(dipoleTmp(3))
     isFirstDet = this%deltaDftb%iDeterminant == 1
@@ -1702,6 +1714,19 @@ contains
       end block
     end if
 
+  #:if WITH_MPI
+    if (env%mpiPostSccInitialised) then
+      savedMpi = env%mpi
+      env%mpi  = env%mpiPostScc
+    end if
+  #:if WITH_SCALAPACK
+    if (env%blacsPostSccInitialised) then
+      savedBlacs = env%blacs
+      env%blacs  = env%blacsPostScc
+    end if
+  #:endif
+  #:endif
+
     call env%globalTimer%startTimer(globalTimers%postSCC)
 
     if (this%isLinResp) then
@@ -1866,6 +1891,13 @@ contains
       call writeEsp(this%electrostatPot, env, iGeoStep, this%nGeoSteps)
     end if
 
+  #:if WITH_MPI
+    if (env%mpiPostSccInitialised) env%mpi = savedMpi
+  #:if WITH_SCALAPACK
+    if (env%blacsPostSccInitialised) env%blacs = savedBlacs
+  #:endif
+  #:endif
+
   end subroutine processGeometry
 
 
diff --git a/src/dftbp/dftbplus/parser.F90 b/src/dftbp/dftbplus/parser.F90
index 883465cf..5f189bee 100644
--- a/src/dftbp/dftbplus/parser.F90
+++ b/src/dftbp/dftbplus/parser.F90
@@ -7703,6 +7703,7 @@ contains
       end if
       allocate(input%ctrl%parallelOpts)
       call getChildValue(node, "Groups", input%ctrl%parallelOpts%nGroup, 1, child=pTmp)
+      call getChildValue(node, "GroupsPostScc", input%ctrl%parallelOpts%nGroupPostScc, 0)
       call getChildValue(node, "UseOmpThreads", input%ctrl%parallelOpts%tOmpThreads, .not. withMpi)
       call readBlacs(node, input%ctrl%parallelOpts%blacsOpts)
     end if

